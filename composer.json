{
    "name": "efabrica/phoenix-core",
    "type": "library",
    "description": "Database Migrations for PHP",
    "keywords": ["PHP", "Database", "Migrations", "Multiple folders", "Query builder", "Create", "Migrate", "Rollback", "Dump", "Status"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "symfony/console": "^8.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "nette/neon": "^3.0",
        "symfony/yaml": "^7.0",
        "phpunit/phpunit": "^9.5.11",
        "ramsey/uuid": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phoenix\\": "src/"
        },
        "classmap": [
            "src/Migration/Init/0_init.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "efabrica/phoenix-mysql": "MySQL adapter (PDO, built on efabrica/phoenix-pdo)",
        "efabrica/phoenix-pgsql": "PostgreSQL adapter (PDO, built on efabrica/phoenix-pdo)",
        "efabrica/phoenix-scylla": "Cassandra / ScyllaDB adapter (requires the cassandra PHP extension)",
        "nette/neon": "Allows use *.neon file as config file and class Phoenix\\Config\\Parser\\NeonConfigParser to parse it",
        "symfony/yaml": "Allows use *.yml / *.yaml file as config file and class Phoenix\\Config\\Parser\\YamlConfigParser to parse it"
    },
    "bin": [
        "bin/phoenix"
    ]
}
